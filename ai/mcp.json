{
  "mcpServers": {
    "1password": {
      "command": "1password-mcp"
    },
    "betterstack": {
      "command": "/Users/stephen/.local/share/mise/shims/mcp-remote",
      "args": [
        "https://mcp.betterstack.com",
        "--header",
        "Authorization: Bearer ${BETTERSTACK_API_TOKEN}"
      ],
      "env": {
        "BETTERSTACK_API_TOKEN": "${BETTERSTACK_API_TOKEN}"
      }
    },
    "chartmogul": {
      "command": "chartmogul",
      "args": ["mcp"]
    },
    "helpscout": {
      "command": "helpscout",
      "args": ["mcp"]
    },
    "tuple": {
      "command": "/usr/local/bin/tuple",
      "args": ["mcp"]
    },
    "tuple-staging": {
      "command": "/usr/local/bin/tuple-staging",
      "args": ["mcp"]
    },
    "ynab": {
      "command": "ynab",
      "args": ["mcp"]
    }
  }
}
