#!/usr/bin/env bash

# Codex uses one real home at ~/.codex. This command reports it and refuses to
# repoint it: BB resolves Codex rollouts through ~/.codex, so a home that moves
# out from under a live session loses thread resume, rename, and archive.

set -euo pipefail

active_path="$HOME/.codex"
compat_paths=("$HOME/.codex-personal" "$HOME/.codex-work")

report_status() {
  if [[ -L $active_path ]]; then
    echo "unstable: $active_path is a symlink to $(readlink -f "$active_path")" >&2
    echo "Restore a single real home before running Codex." >&2
    return 1
  fi
  [[ -d $active_path ]] || { echo "missing: $active_path" >&2; return 1; }

  printf 'unified\n'
  printf 'home: %s\n' "$active_path"
  for path in "${compat_paths[@]}"; do
    if [[ -L $path ]]; then
      printf 'compat: %s -> %s\n' "$path" "$(readlink -f "$path")"
    elif [[ -e $path ]]; then
      printf 'compat: %s (independent home, not unified)\n' "$path"
    fi
  done
}

refuse_switch() {
  cat >&2 <<'MESSAGE'
Codex profile switching is disabled. ~/.codex is one real home shared by every
Codex and BB process, and repointing it breaks BB rollout lookup for threads
that were already created.

Run a single process against a separate home instead:
  CODEX_HOME=/path/to/other-home codex ...

Authenticate the unified home with:
  codex login --device-auth
MESSAGE
  exit 3
}

case "${1:-status}" in
  status) report_status ;;
  personal | work | toggle) refuse_switch ;;
  *) echo "Usage: codex-profile [status]" >&2; exit 2 ;;
esac
