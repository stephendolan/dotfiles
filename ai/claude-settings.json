{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm:-rf /*)",
      "Bash(rm:-rf /)",
      "Bash(rm:-rf ~:*)",
      "Bash(rm:-rf $HOME:*)",
      "Bash(git:push --force origin main)",
      "Bash(git:push --force origin master)",
      "Bash(git:push -f origin main)",
      "Bash(git:push -f origin master)",
      "Bash(git:reset --hard:*)",
      "Bash(git:clean -fd:*)",
      "Bash(psql:-c DROP DATABASE:*)",
      "Bash(psql:-c DROP TABLE:*)",
      "Bash(psql:-c TRUNCATE TABLE:*)",
      "Bash(psql:-c TRUNCATE:*)"
    ],
    "ask": [
      "Bash(gh pr comment:*)",
      "Bash(bin/deploy:*)",
      "Bash(./bin/deploy:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "statusLine": {
    "type": "command",
    "command": "~/.dotfiles/ai/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/ai/hooks/tmux-rename-session.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo -e '\\a\\033]777;notify;Claude Code;Needs attention\\007'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "attribution": {
    "sessionUrl": false
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc",
        "skipLfs": true
      },
      "autoUpdate": true
    },
    "dotfiles": {
      "source": {
        "source": "github",
        "repo": "stephendolan/dotfiles",
        "skipLfs": true
      },
      "autoUpdate": true
    },
    "private-skills": {
      "source": {
        "source": "github",
        "repo": "stephendolan/private-skills",
        "skipLfs": true
      },
      "autoUpdate": true
    },
    "mattpocock": {
      "source": {
        "source": "git",
        "url": "https://github.com/mattpocock/skills.git"
      }
    }
  },
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "spinnerTipsOverride": {
    "tips": [
      "Reading your codebase...",
      "Analyzing dependencies...",
      "Checking for bugs...",
      "Optimizing performance...",
      "Writing tests...",
      "Reviewing changes...",
      "Exploring the architecture..."
    ]
  },
  "preferredNotifChannel": "ghostty",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true
}
