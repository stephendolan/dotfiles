#!/usr/bin/env bash
set -euo pipefail

# Tuple's trigger runner is launched without the interactive shell's PATH. The
# Codex CLI is installed through mise, so include its stable shim directory.
export PATH="${HOME}/.local/bin:${HOME}/.local/share/mise/shims:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:${PATH:-}"

CALL_ID="${TUPLE_TRIGGER_CALL_ID:-}"
RECORDING_ID="${TUPLE_TRIGGER_RECORDING_ID:-}"
UUID_RE='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'

if [[ ! "${CALL_ID}" =~ ${UUID_RE} ]]; then
  echo "canvas-curator: missing or invalid TUPLE_TRIGGER_CALL_ID" >&2
  exit 2
fi
if [[ ! "${RECORDING_ID}" =~ ${UUID_RE} ]]; then
  echo "canvas-curator: missing or invalid TUPLE_TRIGGER_RECORDING_ID" >&2
  exit 2
fi
if ! command -v jq >/dev/null 2>&1; then
  echo "canvas-curator: jq is required" >&2
  exit 127
fi
CANVAS_ROOT="${CALL_CANVAS_ROOT:-${HOME}/Documents/Tuple Call Canvases}"
CALL_DIR="${CANVAS_ROOT}/${CALL_ID}"
CANVAS_APP_ROOT="${CALL_CANVAS_APP_ROOT:-${HOME}/Repos/@tuple/tuple-call-canvas}"
CODEX_PROJECT_ROOT="${CALL_CANVAS_CODEX_PROJECT_ROOT:-${HOME}/Documents/Tuple Calls 2}"
TRIGGER_DIR="$(cd "$(dirname "$0")" && pwd)"
DESKTOP_THREAD_RUNNER="${TRIGGER_DIR}/codex-desktop-thread.py"
CLAIM_DIR="${CALL_DIR}/.launched-${RECORDING_ID}"
ACTIVE_DIR="${CANVAS_ROOT}/.active-recordings"
COMPLETION_SIGNAL="/tmp/tuple-call-canvas-complete-${RECORDING_ID}"
mkdir -p "${CALL_DIR}/assets" "${ACTIVE_DIR}"

# Tuple tears down a trigger's child process group when the trigger exits, and
# launchd jobs do not inherit this script's PATH or HOME. Submit long-running
# work through /usr/bin/env so Node-backed shims and Codex's config/MCP servers
# remain available after the trigger returns.
submit_user_job() {
  local job_label="$1" output_file="$2" error_file="$3"
  shift 3
  /bin/launchctl submit -l "${job_label}" -o "${output_file}" -e "${error_file}" -- \
    /usr/bin/env \
    "HOME=${HOME}" \
    "PATH=${PATH}" \
    "TMPDIR=${TMPDIR:-/tmp}" \
    "$@"
}

# mkdir is the duplicate-firing guard. A transcription restart has a new
# recording ID and therefore resumes the same call workspace in a new thread.
if ! mkdir "${CLAIM_DIR}" 2>/dev/null; then
  echo "canvas-curator: recording ${RECORDING_ID:0:8} already launched; no-op"
  exit 0
fi

# Clear the completion signal only once the claim is held. A duplicate start
# event arriving after this recording completed would otherwise erase the
# signal the curator is waiting on and strand it before its final turn.
rm -f "${COMPLETION_SIGNAL}"

if ! curl -fsS http://127.0.0.1:5858/health >/dev/null 2>&1; then
  if [[ ! -f "${CANVAS_APP_ROOT}/package.json" ]]; then
    rmdir "${CLAIM_DIR}" 2>/dev/null || true
    echo "canvas-curator: app not found at ${CANVAS_APP_ROOT}" >&2
    exit 127
  fi
  NPM_BIN="$(mise which npm 2>/dev/null || command -v npm || true)"
  if [[ -z "${NPM_BIN}" || ! -x "${NPM_BIN}" ]]; then
    rmdir "${CLAIM_DIR}" 2>/dev/null || true
    echo "canvas-curator: npm is required" >&2
    exit 127
  fi
  RUNTIME_LABEL="com.stephen.tuple-canvas.runtime"
  /bin/launchctl remove "${RUNTIME_LABEL}" 2>/dev/null || true
  submit_user_job \
    "${RUNTIME_LABEL}" \
    "${CANVAS_ROOT}/runtime.log" \
    "${CANVAS_ROOT}/runtime.err.log" \
    "${NPM_BIN}" --prefix "${CANVAS_APP_ROOT}" run dev
  printf '%s\n' "${RUNTIME_LABEL}" > "${CANVAS_ROOT}/runtime.launchd"
  for _ in {1..24}; do
    curl -fsS http://127.0.0.1:5858/health >/dev/null 2>&1 && break
    sleep 0.25
  done
  if ! curl -fsS http://127.0.0.1:5858/health >/dev/null 2>&1; then
    rmdir "${CLAIM_DIR}" 2>/dev/null || true
    echo "canvas-curator: local canvas failed to start" >&2
    exit 1
  fi
fi

CANVAS_BASE_URL="${CALL_CANVAS_PUBLIC_URL:-}"
if [[ -z "${CANVAS_BASE_URL}" ]]; then
  CANVAS_BASE_URL="$(curl -fsS http://127.0.0.1:4040/api/tunnels 2>/dev/null \
    | jq -r '[.tunnels[] | select(.proto == "https" and ((.config.addr // "") | test("(^|:)5757$"))) | .public_url][0] // empty' || true)"
fi
# A tunnel listed by ngrok's local API can already be dead (for example after
# ngrok restarts). Do not hand participants a stale public URL.
if [[ -n "${CANVAS_BASE_URL}" ]] && ! curl -fsS --max-time 5 "${CANVAS_BASE_URL%/}/" >/dev/null 2>&1; then
  echo "canvas-curator: existing public canvas URL is unreachable; starting a fresh tunnel" >&2
  CANVAS_BASE_URL=""
fi
# Cold-starting a tunnel can add six seconds before the local canvas or curator
# appears. Reuse an already-running tunnel automatically, but only start a new
# one when explicitly requested; localhost is the latency-optimized default.
if [[ -z "${CANVAS_BASE_URL}" && "${CALL_CANVAS_DRY_RUN:-}" != "1" && "${CALL_CANVAS_START_TUNNEL:-}" == "1" ]] && command -v ngrok >/dev/null 2>&1; then
  NGROK_BIN="$(command -v ngrok)"
  NGROK_LABEL="com.stephen.tuple-canvas.ngrok"
  /bin/launchctl remove "${NGROK_LABEL}" 2>/dev/null || true
  submit_user_job \
    "${NGROK_LABEL}" \
    "${CANVAS_ROOT}/ngrok.log" \
    "${CANVAS_ROOT}/ngrok.err.log" \
    "${NGROK_BIN}" http 5757 --log=stdout
  printf '%s\n' "${NGROK_LABEL}" > "${CANVAS_ROOT}/ngrok.launchd"
  for _ in {1..24}; do
    CANVAS_BASE_URL="$(curl -fsS http://127.0.0.1:4040/api/tunnels 2>/dev/null \
      | jq -r '[.tunnels[] | select(.proto == "https" and ((.config.addr // "") | test("(^|:)5757$"))) | .public_url][0] // empty' || true)"
    [[ -n "${CANVAS_BASE_URL}" ]] && break
    sleep 0.25
  done
fi
CANVAS_BASE_URL="${CANVAS_BASE_URL:-http://localhost:5757}"
if [[ "${CANVAS_BASE_URL}" != "http://localhost:5757" ]] && ! curl -fsS --max-time 5 "${CANVAS_BASE_URL%/}/" >/dev/null 2>&1; then
  rmdir "${CLAIM_DIR}" 2>/dev/null || true
  echo "canvas-curator: public canvas URL did not become reachable" >&2
  exit 1
fi
CANVAS_URL="${CANVAS_BASE_URL%/}/?room=${CALL_ID}"

SESSION_FILE="${CALL_DIR}/session-${RECORDING_ID}.json"
jq -n \
  --arg call_id "${CALL_ID}" \
  --arg recording_id "${RECORDING_ID}" \
  --arg environment "staging" \
  --arg canvas_room "${CALL_ID}" \
  --arg canvas_url "${CANVAS_URL}" \
  --arg launched_at "$(date -u +%FT%TZ)" \
  '{call_id:$call_id,recording_id:$recording_id,environment:$environment,canvas_room:$canvas_room,canvas_url:$canvas_url,launched_at:$launched_at}' \
  > "${SESSION_FILE}"
if [[ "${CALL_CANVAS_DRY_RUN:-}" != "1" ]]; then
  touch "${ACTIVE_DIR}/${RECORDING_ID}"
fi

PROMPT="Use \$tuple-call-canvas to curate the live Tuple staging call ${CALL_ID}, recording ${RECORDING_ID}, in tldraw room ${CALL_ID} at ${CANVAS_URL}. This task belongs to the Tuple Calls Codex project, but ${CALL_DIR} is its durable call-data directory; read session-${RECORDING_ID}.json there before writing. Start immediately, follow only this recording, preserve evidence timestamps, and continue until its recording-complete-${RECORDING_ID} marker. The shell sandbox may block direct localhost curl even while the canvas MCP is healthy: treat a successful canvas_read as authoritative and never start another canvas server yourself. Keep the canvas spatial and visual rather than transcript-like. Do not rename or otherwise mutate the Tuple call, send messages, or create external tasks."

start_curator() {
  local codex_bin
  codex_bin="$(mise which codex 2>/dev/null || command -v codex || true)"
  if [[ -z "${codex_bin}" || ! -x "${codex_bin}" ]]; then
    echo "canvas-curator: Codex CLI is required" >&2
    return 1
  fi

  local output_file="${CALL_DIR}/curator-${RECORDING_ID}.log"
  local error_file="${CALL_DIR}/curator-${RECORDING_ID}.err.log"
  local prompt_file="${CALL_DIR}/curator-${RECORDING_ID}.prompt.txt"
  local metadata_file="${CALL_DIR}/curator-${RECORDING_ID}.desktop.json"
  local result_file="${CALL_DIR}/curator-${RECORDING_ID}.result.md"
  local job_label="com.stephen.tuple-canvas.${RECORDING_ID}"
  if [[ ! -x "${DESKTOP_THREAD_RUNNER}" ]]; then
    echo "canvas-curator: Desktop thread runner is missing" >&2
    return 1
  fi
  if [[ ! -d "${CODEX_PROJECT_ROOT}" ]]; then
    echo "canvas-curator: Tuple Calls Codex project is missing at ${CODEX_PROJECT_ROOT}" >&2
    return 1
  fi
  printf '%s\n' "${PROMPT}" > "${prompt_file}"
  # Tuple cleans up child process groups once a trigger exits. Submit the
  # curator as a user job so it remains alive for the duration of the call.
  # Remove an earlier failed launch with this exact recording label before a
  # deliberately retried claim; launchctl otherwise retains the broken job.
  /bin/launchctl remove "${job_label}" 2>/dev/null || true
  submit_user_job "${job_label}" "${output_file}" "${error_file}" \
    /usr/bin/python3 "${DESKTOP_THREAD_RUNNER}" \
    --codex "${codex_bin}" \
    --project "${CODEX_PROJECT_ROOT}" \
    --workspace-root "${CALL_DIR}" \
    --workspace-root "${CANVAS_APP_ROOT}" \
    --prompt "${PROMPT}" \
    --metadata-file "${metadata_file}" \
    --result-file "${result_file}" \
    --completion-signal "${COMPLETION_SIGNAL}" \
    --title "Tuple staging call ${CALL_ID:0:8}" \
    --model "${CALL_CANVAS_MODEL:-gpt-5.6-luna}" \
    --effort "${CALL_CANVAS_REASONING_EFFORT:-high}" \
    --service-tier "${CALL_CANVAS_SERVICE_TIER:-priority}"
  printf '%s\n' "${job_label}" > "${CALL_DIR}/curator-${RECORDING_ID}.launchd"
}

echo "canvas-curator: prepared call ${CALL_ID:0:8} recording ${RECORDING_ID:0:8}"
echo "canvas-curator: call data ${CALL_DIR}"
echo "canvas-curator: canvas ${CANVAS_URL}"

if [[ "${CALL_CANVAS_DRY_RUN:-}" == "1" ]]; then
  echo "canvas-curator: dry run; Codex Desktop task prompt length ${#PROMPT}"
  exit 0
fi

if ! start_curator; then
  rmdir "${CLAIM_DIR}" 2>/dev/null || true
  rm -f "${ACTIVE_DIR}/${RECORDING_ID}"
  echo "canvas-curator: failed to start curator" >&2
  exit 1
fi

echo "canvas-curator: curator started"

# Opening the browser is independent of task creation. Submit the durable
# curator first so app-server startup overlaps the browser handoff.
open "${CANVAS_URL}" || echo "canvas-curator: could not open canvas browser" >&2
