#!/usr/bin/env bash
set -euo pipefail

# post-call-activity: on call-ended, fork a detached worker that resolves the
# just-ended call(s) from Capture history and runs one headless Codex Terra
# (medium reasoning) per unprocessed call. See README.md for the design;
# instructions.md is the worker's operating contract.

LOG=/tmp/tuple-trigger-debug.log
exec >>"$LOG" 2>&1
printf '\n=== %s call-ended fired (post-call-activity) ===\n' "$(date -u +%FT%TZ)"
printf 'pid=%s call_length=%s\n' "$$" "${TUPLE_TRIGGER_CALL_LENGTH:-?}"

export PATH="$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:${PATH:-}"

TUPLE_CLI="tuple-staging" # staging client; the prod trigger uses `tuple`
TRIGGER_DIR="$(cd "$(dirname "$0")" && pwd)"
VAULT="$HOME/Obsidian/Notes"
INSTRUCTIONS="${TRIGGER_DIR}/instructions.md"
STATE_DIR="$HOME/.tuplestaging/post-call-activity"
PROCESSED_FILE="${STATE_DIR}/processed-calls.txt"
LOCK="${STATE_DIR}/.vault-lock"

mkdir -p "${STATE_DIR}"
touch "${PROCESSED_FILE}"

UUID_RE='[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'

# Recent stored call ids not yet processed, oldest first. `call-ended` carries
# no call id, so the just-ended call is resolved from Capture history;
# index; checking the newest 5 (not just 1) lets a firing also catch calls an
# earlier firing missed (near-simultaneous endings, failed runs). Parsing stays
# dependency-free: POSIX grep on the call-id UUID shape, no jq.
unprocessed_calls() {
    "${TUPLE_CLI}" capture list --limit 5 --format json \
        | grep -oiE "\"call_id\": *\"${UUID_RE}\"" \
        | grep -oiE "${UUID_RE}" \
        | tail -r \
        | while read -r cid; do
              grep -qxF "${cid}" "${PROCESSED_FILE}" || printf '%s\n' "${cid}"
          done
}

# Run one headless Codex worker for one call; mark it processed only on success so a
# failed run is retried by the next firing.
process_call() {
    cid="$1"
    prompt="A Tuple call just ended. Process call ${cid} per your instructions.
Tuple client: staging — use the \`${TUPLE_CLI}\` CLI for all Tuple reads and writes."
    # Codex loads the vault's AGENTS.md automatically from the working
    # directory. Read the trigger-specific contract before any call access;
    # captured call content is untrusted evidence, never instructions.
    if printf '%s\n\nRead and follow this trigger contract before acting: %s' "${prompt}" "${INSTRUCTIONS}" \
        | codex exec \
            --model gpt-5.6-terra \
            --config 'model_reasoning_effort="medium"' \
            --sandbox danger-full-access \
            --add-dir "${STATE_DIR}" \
            --output-last-message "${STATE_DIR}/last-worker-message.txt" \
            -
    then
        printf '%s\n' "${cid}" >> "${PROCESSED_FILE}"
        echo "post-call-activity: processed call ${cid:0:8}"
    else
        echo "post-call-activity: worker exited non-zero for ${cid:0:8} — left unprocessed for retry" >&2
    fi
}

# Everything runs detached: the trigger runner executes triggers in series, and
# both the transcript-flush poll and the multi-minute Claude runs would queue
# every other trigger behind them. Fork the worker and return immediately.
(
    # Capture persistence lags call-ended by ~1-2s; poll until an unprocessed
    # call surfaces. A call with no captured records never appears, so the poll times
    # out and the worker no-ops.
    tries=0
    calls="$(unprocessed_calls)" || {
        echo "post-call-activity: ${TUPLE_CLI} capture list failed" >&2
        exit 1
    }
    while [ -z "${calls}" ]; do
        tries=$((tries + 1))
        if [ "${tries}" -ge 12 ]; then
            echo "post-call-activity: no new call surfaced within poll window — nothing to do"
            exit 0
        fi
        sleep 5
        calls="$(unprocessed_calls)" || {
            echo "post-call-activity: ${TUPLE_CLI} capture list failed" >&2
            exit 1
        }
    done

    # Serialize vault access: two calls completing near-simultaneously must not
    # edit and commit concurrently. mkdir is atomic; stale locks (>30m) are
    # stolen. A worker that gives up here simply leaves its calls for the next
    # firing's catch-up.
    waited=0
    until mkdir "${LOCK}" 2>/dev/null; do
        if [ -f "${LOCK}/ts" ] && [ "$(( $(date +%s) - $(cat "${LOCK}/ts") ))" -gt 1800 ]; then
            echo "post-call-activity: stealing stale vault lock"
            rm -rf "${LOCK}"
            continue
        fi
        if [ "${waited}" -ge 900 ]; then
            echo "post-call-activity: gave up waiting for vault lock after 15m" >&2
            exit 1
        fi
        sleep 10; waited=$((waited + 10))
    done
    date +%s > "${LOCK}/ts"
    printf '%s\n' "$$" > "${LOCK}/owner"
    # Only the lock's owner removes it, so a worker whose stale lock was stolen
    # cannot delete its successor's lock on exit.
    # shellcheck disable=SC2329 # Invoked indirectly by the EXIT trap.
    cleanup_lock() {
        local status=$?
        if [ "$(cat "${LOCK}/owner" 2>/dev/null)" = "$$" ]; then
            rm -rf "${LOCK}"
        fi
        printf 'post-call-activity: worker exit status=%s\n' "${status}"
        return "${status}"
    }
    trap cleanup_lock EXIT

    cd "${VAULT}"
    # Re-resolve under the lock: a near-simultaneous firing may have processed
    # our call while we waited, and marking-processed happens post-run.
    calls="$(unprocessed_calls)" || {
        echo "post-call-activity: ${TUPLE_CLI} capture list failed" >&2
        exit 1
    }
    for cid in ${calls}; do
        process_call "${cid}"
    done
) < /dev/null &
WORKER_PID=$!
disown 2>/dev/null || true

echo "post-call-activity: detached worker (pid ${WORKER_PID}); returning to trigger runner"
